# 复制成 config.local.json（已在 .gitignore 里），填自己的信息。
# 授权码不要写进来，用 passwordFile 指向 0600 文件，或用 DSH_MAIL_REMOTE_PASSWORD 环境变量。
{
  "enabled": true,
  "provider": "qq",
  "user": "你的QQ邮箱@qq.com",
  "passwordFile": "~/.dsh-secrets/qq-mail.pass",
  "allowFrom": ["你的QQ邮箱@qq.com"],
  "subjectToken": "[DSH-7f3a]",
  "workdir": "~/DSH-Remote",
  "permissionPreset": "read-only",
  "approvalPolicy": "never",
  "pollSeconds": 60,
  "maxPerHour": 6,
  "replyEnabled": true,
  "dryRun": false
}
